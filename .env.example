# 로컬에서 --dry-run 을 돌릴 때 쓰는 예시.
# 실제 값을 채운 .env 는 절대 커밋하지 않는다 (.gitignore 에 포함되어 있음).
# 운영 환경의 값은 GitHub 레포 Settings > Secrets and variables > Actions 에 있다.

SLACK_BOT_TOKEN=xoxb-여기에-봇-토큰
FINANCE_CHANNEL_ID=C여기에-채널-ID
ACCOUNTANT_USERGROUP=회계-User-Group-핸들
COHORT_START_DATE=2026-01-01

# 아래는 선택. 비우면 기본값이 쓰인다.
REMIND_AFTER_HOURS=48
DONE_EMOJI=white_check_mark
SKIP_EMOJI=x
